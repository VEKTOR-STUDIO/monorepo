# -----------------------------------------------------------------------------
# Centro de control. Todo es opcional: sin este archivo funciona igual.
# -----------------------------------------------------------------------------

# --- La rutina de Claude -------------------------------------------------------
# Con qué permisos corre `claude -p` cuando una tarjeta pasa a «Por hacer».
#   acceptEdits        → edita archivos sin preguntar y solo ejecuta los
#                        comandos de la lista de libs/rutina.mjs (PERMITIDAS).
#   bypassPermissions  → no pregunta nada. Más rápido y sin tropiezos, pero sin
#                        red: úsalo solo si te fías de lo que hay en el repo.
CONTROL_CLAUDE_MODO=acceptEdits

# Modelo de la rutina. Vacío = el que tengas por defecto en Claude Code.
CONTROL_CLAUDE_MODELO=

# Ruta del ejecutable, si `claude` no está en el PATH del servidor.
CONTROL_CLAUDE_BIN=
