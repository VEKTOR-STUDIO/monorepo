# -----------------------------------------------------------------------------
# Variables de entorno de LM 2006. Copia este archivo a `.env.local`.
#
# Esta página no tiene base de datos: el catálogo vive en data/vehiculos.json y
# la tasa del BCV se pide a una API pública. Lo único que hay que configurar es
# el modo demo, su contraseña y el dominio.
# -----------------------------------------------------------------------------

# --- Modo demo ----------------------------------------------------------------
# Vacío = demo ACTIVA (puerta con contraseña, inventario cortado a la sexta
# unidad, contacto bloqueado). Ponlo en `false` el día que se entregue.
NEXT_PUBLIC_DEMO=

# --- Contraseña de la demo -----------------------------------------------------
# La puerta de entrada. Solo se pide con la demo activa; con
# NEXT_PUBLIC_DEMO=false desaparece.
#
# Si se deja vacía se usa la de reserva que hay en libs/acceso.js, para que la
# demo nunca quede abierta por olvido. Pon aquí la tuya antes de repartir el
# enlace.
DEMO_PASSWORD=

# --- Dominio ------------------------------------------------------------------
# Lo usan el mapa del sitio y las URL canónicas. Sin esto se usa el de
# config.js.
SITE_URL=

# --- Correo (opcional) --------------------------------------------------------
# Todavía sin usar: el formulario de contacto no reenvía a ningún sitio. Ver el
# PENDIENTE de app/api/contacto/route.js.
RESEND_API_KEY=
