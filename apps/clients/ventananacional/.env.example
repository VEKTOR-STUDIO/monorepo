# Copiar a .env.local y rellenar. Nunca subir secretos reales al repositorio.
#
# Esta página arranca sin nada de esto: el inventario sale de
# data/vehiculos.json y la tasa del BCV de una API pública. No hay base de
# datos ni cuentas de usuario; el contacto es por WhatsApp.

# --- Modo demo ----------------------------------------------------------------
# Con la demo activa hay que pasar una puerta con contraseña, el inventario se
# corta al sexto vehículo y el contacto no sale hacia el WhatsApp del negocio.
# Se ve casi todo, no se puede usar nada.
#
#   (vacío o cualquier cosa)  demo ACTIVA
#   false                     demo apagada → la página de verdad
#
# El precio, el enlace de compra y cuántos vehículos se ven antes del muro
# están en config.js, en el bloque `demo`.
NEXT_PUBLIC_DEMO=

# --- Contraseña de la demo -----------------------------------------------------
# La puerta de entrada. Solo se pide cuando la demo está activa; con
# NEXT_PUBLIC_DEMO=false desaparece.
#
# Si se deja vacía se usa la de reserva que hay en libs/acceso.js, para que la
# demo nunca quede abierta por olvido. Pon aquí la tuya antes de repartir el
# enlace.
DEMO_PASSWORD=

# --- Dominio ------------------------------------------------------------------
# Para el sitemap y las URL absolutas en producción.
SITE_URL=

# --- Correo (opcional) --------------------------------------------------------
# Solo si algún día el formulario de contacto avisa por correo.
RESEND_API_KEY=
