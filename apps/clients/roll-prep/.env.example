# -----------------------------------------------------------------------------
# Supabase — OBLIGATORIO. Sin esto la app no arranca.
# Project Settings → API en el dashboard de Supabase.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Lo usa el panel del profesor para eliminar cuentas de auth
# (app/dashboard/admin/actions.js). Sin esto, todo lo demás funciona pero el
# botón de eliminar usuario avisa que falta la llave. NUNCA exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# URL pública del sitio — recomendado en producción.
# NEXT_PUBLIC_SITE_URL: respaldo para el redirect del magic link cuando el
#   proxy no manda la cabecera x-forwarded-host.
# SITE_URL: la que usa next-sitemap al generar sitemap.xml y robots.txt.
# Sin ellas se cae al dominio de config.js (rollprep.alessandrovaru.com).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rollprep.alessandrovaru.com
SITE_URL=https://rollprep.alessandrovaru.com

# -----------------------------------------------------------------------------
# Resend — opcional. Los magic links los manda Supabase, no la app.
# Solo hace falta si se usa el helper de libs/resend.js (hoy nadie lo importa).
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Stripe — sin uso en RollPrep (queda de la plantilla ShipFast).
# Solo si algún día se cobran membresías desde la app.
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
