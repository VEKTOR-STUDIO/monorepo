# Copy to .env.local and fill in. Never commit real secrets.

# Optional: landing-only mode (bypass auth routes)
NEXT_PUBLIC_LANDING_ONLY=

# Resend (emails)
RESEND_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Site URL for sitemaps (production)
SITE_URL=

# OpenAI (optional, if using libs/gpt.js)
OPENAI_API_KEY=
