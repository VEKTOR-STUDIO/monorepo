# Copiar a .env.local y rellenar. Nunca subir secretos reales al repositorio.
#
# La tienda arranca sin nada de esto: lee el catálogo de data/catalogo.json y
# la tasa del BCV de una API pública. Supabase hace falta para guardar pedidos
# y para que el panel escriba.

# --- Modo demo ----------------------------------------------------------------
# Con la demo activa el catálogo se corta a los primeros productos, el pedido
# no sale hacia WhatsApp y el panel no guarda nada. Se ve casi todo, no se
# puede usar nada.
#
#   (vacío o cualquier cosa)  demo ACTIVA
#   false                     demo apagada → tienda real
#
# El precio, el enlace de compra y cuántos productos se ven antes del muro
# están en config.js, en el bloque `demo`.
NEXT_PUBLIC_DEMO=

# --- Contraseña de la demo -----------------------------------------------------
# La puerta de entrada (pantalla con el logo). Solo se pide cuando la demo
# está activa; con NEXT_PUBLIC_DEMO=false desaparece.
#
# Si se deja vacía se usa la de reserva que hay en libs/acceso.js, para que la
# demo nunca quede abierta por olvido. Pon aquí la tuya.
DEMO_PASSWORD=

# --- Supabase -----------------------------------------------------------------
# Proyecto PROPIO de Hardcore. No reutilizar el de otro cliente del monorepo.
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Se salta RLS: solo servidor, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dominio ------------------------------------------------------------------
# Para el sitemap y las URL absolutas en producción.
SITE_URL=

# --- Correo (opcional) --------------------------------------------------------
# Solo si más adelante se avisa por correo de cada pedido.
RESEND_API_KEY=

# --- Desarrollo (opcional) ----------------------------------------------------
# Ver /admin sin login en local. Se ignora en producción.
NEXT_PUBLIC_DEV_NO_LOGIN=
# Solo la portada, sin rutas con sesión.
NEXT_PUBLIC_LANDING_ONLY=
