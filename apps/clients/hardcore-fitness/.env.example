# Copiar a .env.local y rellenar. Nunca subir secretos reales al repositorio.
#
# La tienda arranca sin nada de esto: lee el catálogo de data/catalogo.json.
# Supabase hace falta para el panel, los pedidos y la tasa del BCV.

# --- Supabase -----------------------------------------------------------------
# Proyecto PROPIO de Hardcore. No reutilizar el de otro cliente del monorepo.
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Se salta RLS: solo servidor, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier cadena larga al azar. Vercel la manda como Authorization: Bearer …
# al llamar a /api/cron/tasa-bcv (ver vercel.json). Generar con:
#   openssl rand -hex 32
CRON_SECRET=

# --- Dominio ------------------------------------------------------------------
# Para el sitemap y las URL absolutas en producción.
SITE_URL=

# --- Correo (opcional) --------------------------------------------------------
# Solo si más adelante se avisa por correo de cada pedido.
RESEND_API_KEY=

# --- Desarrollo (opcional) ----------------------------------------------------
# Ver /admin sin login en local. Se ignora en producción.
NEXT_PUBLIC_DEV_NO_LOGIN=
# Solo la portada, sin rutas con sesión.
NEXT_PUBLIC_LANDING_ONLY=
